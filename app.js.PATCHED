            your codebase, and more — all with configurable permissions.

            Run \`copilot <command> --help\` for details on any subcommand.`).version(Z3e(),"-v, --version","show version information").configureHelp(t9e).allowUnknownOption(!1).allowExcessArguments(!1).configureOutput({writeOut:t=>process.stdout.write(t.replace(/(--[\w-]+) \[/g,"$1[=")),writeErr:t=>process.stderr.write(t.replace(/(--[\w-]+) \[/g,"$1[=")),outputError:(t,e)=>{let n=g5t(t,process.argv.slice(2));if(n!==void 0){e(n);return}t.includes("error: unknown option")||t.includes("error: unknown command")?(e(t),e(`
